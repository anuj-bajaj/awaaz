# Copy this file to .env and fill in your own values. Never commit .env.
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional: email each new ticket to the department (Gmail app password, 2-Step Verification required).
# Leave these three out to run without email.
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your16letterapppassword
# NOTIFY_TO=yourname@gmail.com

# Persistent storage (recommended on Render): a PostgreSQL connection string from Neon, Supabase, etc.
# Leave it out locally and a tickets.db file is used instead. On Render's free plan that file is wiped on every restart.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: PIN required by the dashboard's Reset button. If unset, Reset only asks for confirmation.
# RESET_PIN=choose-a-pin

# Optional: pin the Groq model. Default order: openai/gpt-oss-120b, then llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Telegram notification for each new ticket (works on Render free, unlike SMTP).
# Create a bot with @BotFather, message it once, then find your chat id.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
